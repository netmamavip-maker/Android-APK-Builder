# APK Builder Studio Configuration

# Server
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Build Configuration
GRADLE_VERSION=8.0
ANDROID_SDK_ROOT=/opt/android-sdk
BUILD_TIMEOUT=3600000
MAX_FILE_SIZE=104857600

# Storage (Local or Cloud)
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/app

# Optional: Firebase/Cloud Storage
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-api-key
FIREBASE_DATABASE_URL=your-database-url

# Logging
LOG_LEVEL=info
LOG_FILE=apk-builder.log

# Security
API_KEY=your-secret-api-key
CORS_ORIGIN=*
